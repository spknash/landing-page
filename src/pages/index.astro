---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import HeroSection from "@/components/HeroSection.astro";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { getHeroCandidate, pinnedHeroSlug } from "@/data/hero-candidates";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const recentPosts = sortedPosts.slice(0, postsConfig.perIndex);
const homePath = getRelativeLocaleUrl(locale, "");
const heroOverride = Astro.url.searchParams.get("hero");
const hero = heroOverride
  ? getHeroCandidate(heroOverride)
  : pinnedHeroSlug
    ? getHeroCandidate(pinnedHeroSlug)
    : undefined;
const rotateDaily = !heroOverride && !pinnedHeroSlug;
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" data-home-path={homePath}>
    <HeroSection
      candidate={hero}
      rotateDaily={rotateDaily}
      timeZone={site.timezone}
      title={site.companyName}
    />

    {
      recentPosts.length > 0 && (
        <section class="bg-background relative">
          <div class="app-layout pb-20 pt-4 sm:pb-24 sm:pt-6">
            <div class="mb-6 flex justify-end">
              <a
                href={getRelativeLocaleUrl(locale, "writings")}
                class="text-muted-foreground hover:text-accent group inline-flex items-center gap-1.5 text-sm transition-colors"
              >
                {t.home.allPosts}
                <IconArrowRight
                  class="size-4 transition-transform group-hover:translate-x-0.5"
                  aria-hidden="true"
                />
              </a>
            </div>
            <ul class="divide-line/40 divide-y">
              {recentPosts.map(data => (
                <Card variant="h2" {...data} />
              ))}
            </ul>
          </div>
        </section>
      )
    }
  </main>
  <Footer />
</Layout>
