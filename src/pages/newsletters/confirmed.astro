---
/** Buttondown sends subscribers here after they click the confirmation link. */
import NewsletterNotice from "@/components/NewsletterNotice.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

const t = useTranslations(Astro.currentLocale ?? config.site.lang);
---

<NewsletterNotice
  title={t.pages.newsletterConfirmedTitle}
  description={t.pages.newsletterConfirmedDesc}
  links={false}
/>
