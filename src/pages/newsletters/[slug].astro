---
import { getCollection, render } from "astro:content";
import PostLayout from "@/layouts/PostLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import BackButton from "@/pages/writings/[...slug]/_components/BackButton.astro";
import { getSortedNewsletters } from "@/utils/getSortedNewsletters";
import config from "@/config";

export async function getStaticPaths() {
  const issues = getSortedNewsletters(await getCollection("newsletters"));
  return issues.map(issue => ({
    params: { slug: issue.id },
    props: { issue },
  }));
}

const { issue } = Astro.props;
const { title, issue: number, pubDatetime, description, author } = issue.data;
const { Content } = await render(issue);
---

<!--
  Deliberately plain for now: the newsletter's own look is being designed
  separately and will replace this layout.
-->
<PostLayout
  title={`${title} | ${config.site.title}`}
  description={description}
  pubDatetime={pubDatetime}
  author={author}
>
  <Header />
  <BackButton />

  <main id="main-content" class="app-layout" data-pagefind-body>
    <p class="text-muted-foreground font-mono text-sm">No. {number}</p>
    <h1 class="text-accent mt-1 text-2xl font-bold sm:text-3xl">{title}</h1>
    <div class="text-muted-foreground my-2 flex items-center gap-2 text-sm">
      <Datetime pubDatetime={pubDatetime} size="lg" />
      <span aria-hidden="true">|</span>
      <span>{author}</span>
    </div>

    <article id="article" class="app-prose max-w-app mt-8 w-full">
      <Content />
    </article>
  </main>

  <Footer />
</PostLayout>
