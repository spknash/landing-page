---
import { getCollection, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import PostLayout from "@/layouts/PostLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import { getSortedNewsletters } from "@/utils/getSortedNewsletters";
import { useTranslations } from "@/i18n";
import config from "@/config";

export async function getStaticPaths() {
  const issues = getSortedNewsletters(await getCollection("newsletters"));
  return issues.map(issue => ({
    params: { slug: issue.id },
    props: { issue },
  }));
}

const { issue } = Astro.props;
const { title, issue: number, pubDatetime, description, author } = issue.data;
const { Content } = await render(issue);

dayjs.extend(utc);
dayjs.extend(timezone);
const published = dayjs(pubDatetime).tz(config.site.timezone);

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<PostLayout
  title={`${title} | ${config.site.title}`}
  description={description}
  pubDatetime={pubDatetime}
  author={author}
>
  <Header />

  <main
    id="main-content"
    class="newsletter-page mx-auto w-full max-w-[40rem] px-6 pt-28 pb-20 sm:pt-32"
    data-pagefind-body
  >
    <p class="text-muted-foreground text-sm italic">
      {t.nav.newsletters} · No. {number} ·{" "}
      <time datetime={published.toISOString()}>
        {published.format("MMMM D, YYYY")}
      </time>
    </p>
    <h1
      class="mt-3 text-4xl leading-[1.1] font-normal text-balance sm:text-5xl"
    >
      {title}
    </h1>
    <p class="text-muted-foreground mt-4 text-base">By {author}</p>

    <article class="newsletter-prose mt-10">
      <Content />
    </article>

    <a
      href={getRelativeLocaleUrl(locale, "newsletters")}
      class="text-muted-foreground hover:text-foreground mt-16 inline-block text-sm italic"
    >
      ← All newsletters
    </a>
  </main>

  <Footer />
</PostLayout>
