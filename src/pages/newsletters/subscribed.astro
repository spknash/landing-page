---
/** Buttondown sends new subscribers here right after they sign up. */
import NewsletterNotice from "@/components/NewsletterNotice.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

const t = useTranslations(Astro.currentLocale ?? config.site.lang);
---

<NewsletterNotice
  title={t.pages.newsletterSubscribedTitle}
  description={t.pages.newsletterSubscribedDesc}
/>
