---
import { getRelativeLocaleUrl } from "astro:i18n";
import { stripBase, stripLocale } from "@/utils/withBase";
import IconExternalLink from "@/assets/icons/IconExternalLink.svg";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const relativePath = stripBase(Astro.url.pathname);
const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;
const currentPath = stripLocale(pathWithoutTrailingSlash, locale);

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());
  return currentPath === path || currentPathArray[0] === pathArray[0];
};
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-background text-accent absolute inset-s-16 -top-full z-50 px-3 py-2 backdrop-blur-lg transition-all focus:top-4"
>
  {t.a11y.skipToContent}
</a>

<header class="fixed inset-x-0 top-0 z-50 flex justify-center px-6 pt-4 sm:pt-5">
  <nav aria-label="Primary" class="glass-nav flex items-center gap-1 p-1 text-sm">
    {
      config.site.mission.length > 0 && (
        <a
          href={getRelativeLocaleUrl(locale, "mission")}
          class="glass-nav-link"
          class:list={{ "active-nav": isActive("/mission") }}
        >
          {t.nav.mission}
        </a>
      )
    }
    <a
      href={getRelativeLocaleUrl(locale, "writings")}
      class="glass-nav-link"
      class:list={{ "active-nav": isActive("/writings") }}
    >
      {t.nav.posts}
    </a>
    <a
      href="https://jungleagents.com"
      target="_blank"
      rel="noopener noreferrer"
      class="glass-nav-cta"
    >
      Try Jungle
      <IconExternalLink class="size-3.5 opacity-90" aria-hidden="true" />
    </a>
  </nav>
</header>
