---
/**
 * A link preview card for newsletter issues: thumbnail on the left, title,
 * one line of context and the site underneath. Use inside `<LinkCards>`.
 *
 * `image` is a remote URL (e.g. a YouTube or og:image thumbnail). Without one,
 * `thumbText` is set in the thumbnail slot instead.
 */
type Props = {
  href: string;
  title: string;
  description?: string;
  site: string;
  image?: string;
  thumbText?: string;
  video?: boolean;
};

const { href, title, description, site, image, thumbText, video } = Astro.props;
---

<a href={href} class="link-card" target="_blank" rel="noopener noreferrer">
  <span class="link-card-thumb">
    {
      image ? (
        <img src={image} alt="" loading="lazy" decoding="async" />
      ) : (
        <span class="link-card-thumb-text">{thumbText ?? title}</span>
      )
    }
    {video && <span class="link-card-play" aria-hidden="true" />}
  </span>
  <span class="link-card-body">
    <span class="link-card-title">{title}</span>
    {description && <span class="link-card-desc">{description}</span>}
    <span class="link-card-site">{site}</span>
  </span>
</a>
