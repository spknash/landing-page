---
/**
 * A quotation set apart from the letter: larger, centered, with a hanging
 * opening mark and the speaker's name underneath. Use inside a newsletter issue.
 */
type Props = { by: string };

const { by } = Astro.props;
---

<figure class="pull-quote">
  <blockquote><slot /></blockquote>
  <figcaption>{by}</figcaption>
</figure>
