---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { getPostPreview } from "@/utils/getPostPreview";
import { toTransitionName } from "@/utils/toTransitionName";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath, body } = Astro.props;

const { title, ...props } = data;
const preview = getPostPreview({ data, body });
const href = getPostUrl(id, filePath, Astro.currentLocale);
---

<li class="group py-6">
  <a href={href} class="block focus-visible:outline-none">
    <Datetime
      {...props}
      class="text-muted-foreground mb-2 text-sm [&_svg]:hidden"
    />
    <Heading
      transition:name={toTransitionName(title)}
      class="font-display group-hover:text-accent text-xl leading-snug font-medium decoration-1 underline-offset-4 transition-colors group-hover:underline sm:text-2xl"
    >
      {title}
    </Heading>
    {
      preview && (
        <p class="text-muted-foreground mt-2 max-w-prose leading-relaxed">
          {preview}
        </p>
      )
    }
  </a>
</li>
